function main() {
    ok = 1;

    x = 0;
    if (x == 0) {
        x = 1;
    } else if (x == 1) {
        ok = 0;
    } else {
        ok = 0;
    }
    if (x != 1) { ok = 0; }

    i = 0;
    while (i < 5) {
        i = i + 1;
    }
    if (i != 5) { ok = 0; }

    j = 0;
    while (1) {
        if (j == 3) { break; }
        j = j + 1;
    }
    if (j != 3) { ok = 0; }

    evens = 0;
    k = 0;
    while (k < 10) {
        k = k + 1;
        if (k % 2 != 0) { continue; }
        evens = evens + 1;
    }
    if (evens != 5) { ok = 0; }

    if (ok) { return 42; }
    return 0;
}
